<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:layout_marginHorizontal="4dp"
    android:background="#170A26"
    android:orientation="horizontal"
    android:padding="20dp"
    android:elevation="4dp">

    <View
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#C77DFF"
        android:layout_marginEnd="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNamaKomponen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Beast PC"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvKategori"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gaming | Custom Build"
            android:textColor="#B388FF"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvHarga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rp 32.000.000"
            android:textColor="#E0B0FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</LinearLayout>